# ========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ========================================
# 
# Copia este archivo como .env y completa con tus valores reales
# NUNCA commitees el archivo .env al repositorio
#

# ========================================
# CONFIGURACIÓN DE TWILIO
# ========================================
# Obtén estos valores desde tu Twilio Console
# https://console.twilio.com/

TWILIO_ACCOUNT_SID=tu_account_sid_aqui
TWILIO_AUTH_TOKEN=tu_auth_token_aqui

# Para desarrollo, usa el número del Sandbox de WhatsApp
# Para producción, usa tu número de WhatsApp Business verificado
TWILIO_PHONE_NUMBER=+14155238886

# ========================================
# CONFIGURACIÓN DE AWS S3
# ========================================
# Crea una cuenta en AWS y configura un bucket S3
# https://aws.amazon.com/s3/

AWS_ACCESS_KEY_ID=tu_access_key_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_key_aqui
AWS_REGION=us-west-1
AWS_S3_BUCKET=tu-bucket-rfi-bot

# ========================================
# CONFIGURACIÓN DE FLASK
# ========================================
# Configuración del servidor web

FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================
# Para desarrollo, SQLite es suficiente
# Para producción, considera PostgreSQL o MySQL

DATABASE_URL=sqlite:///rfi_bot.db

# Ejemplo para PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/rfi_bot

# ========================================
# CONFIGURACIÓN ADICIONAL (OPCIONAL)
# ========================================

# Clave secreta para sesiones (genera una aleatoria)
SECRET_KEY=tu_clave_secreta_muy_larga_y_aleatoria

# Configuración de logs
LOG_LEVEL=INFO
LOG_FILE=app.log

# Configuración de límites
MAX_FILE_SIZE=5242880  # 5MB en bytes
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,gif,webp

# ========================================
# NOTAS IMPORTANTES
# ========================================
#
# 1. SEGURIDAD:
#    - Nunca compartas estas credenciales
#    - Usa valores diferentes para desarrollo y producción
#    - Rota las claves periódicamente
#
# 2. TWILIO SANDBOX:
#    - Para desarrollo, únete al sandbox de WhatsApp
#    - Envía "join <código>" al +1 415 523 8886
#    - Para producción, verifica tu número de negocio
#
# 3. AWS S3:
#    - Crea un bucket con acceso público de lectura
#    - Configura CORS si planeas acceso desde navegadores
#    - Considera configurar lifecycle policies para costos
#
# 4. FLASK:
#    - En producción, cambia FLASK_ENV a 'production'
#    - Usa un servidor WSGI como gunicorn
#    - Configura HTTPS con certificados SSL
#
# ========================================
